{
  "include": [
    "app",
    "test",
    ".react-router/types/**/*",
    "vite.config.ts",
    "react-router.config.ts"
  ],
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "paths": {
      "viem": [
        "./node_modules/viem"
      ],
      "@noble/curves/*": [
        "./node_modules/@noble/curves/*"
      ],
      "@noble/hashes/*": [
        "./node_modules/@noble/hashes/*"
      ],
      "@zkpassport/poseidon2": [
        "./node_modules/@zkpassport/poseidon2"
      ]
    }
  },
  "exclude": [
    "api",
    "server.ts",
    "node_modules",
    "build"
  ]
}
