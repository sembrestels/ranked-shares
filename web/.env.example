# Deploy from /deploy. Leave the pool empty until a round is created.
VITE_RPC_URL=https://rpc.testnet.arc.io
VITE_CHAIN_ID=5042002
VITE_CHAIN_NAME=Arc Testnet
VITE_NATIVE_SYMBOL=USDC
VITE_POOL_ADDRESS=
# Only needed on other networks: configure the USDC and EURC contracts for that chain.
# Arc Testnet always uses the official addresses.
VITE_USDC_ADDRESS=
VITE_EURC_ADDRESS=
# Operator-owned public provisioning endpoint. Leave empty until a real tally
# service supports this chain/build. No API keys or tally secrets belong in VITE_.
# See docs/tally-provisioning.md for the required service protocol.
VITE_TALLY_SERVICE_URL=
# For the LP demo, set the deployed PositionManager's first block for NFT discovery.
VITE_LP_FROM_BLOCK=0
# Public configuration only. Swarm ID manages the user's storage credentials.
VITE_SWARM_ID_ORIGIN=https://swarm-id.snaha.net
# Ballots use Arkiv Tiramisu (7738577); the pool remains on VITE_CHAIN_ID.
VITE_ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
# Optional: display name for VITE_POOL_ADDRESS only.
VITE_ROUND_NAME=
# Optional: featured rounds on VITE_CHAIN_ID, as a JSON array of {pool, name}.
# VITE_ROUNDS='[{"pool":"0x...","name":"Community grants"},{"pool":"0x...","name":"Builders round"}]'
VITE_ROUNDS=
# Optional: the repo linked from "check this result yourself" (default the RankedShares repo).
VITE_REPO_URL=
# Optional: voters per close(maxVoters) transaction (default 100).
VITE_CLOSE_CHUNK=
# Optional: base URL for the read API when it is not same-origin (default same-origin).
VITE_API_URL=
# Optional: the deployed site's own URL, baked into canonical links and og:url
# for prerendered pages at build time (default http://localhost:5174).
VITE_SITE_URL=
# Optional: a Bee gateway for resolving project titles at build time for
# prerendered meta tags (falls back to BEE_URL below when unset).
VITE_BEE_URL=

# ------------------------------------------------------------------ api
# The read API (deno task dev:api on its own, deno task start with the SPA).
# API variables win; the VITE_ ones above are used as fallbacks.
PORT=8000
RPC_URL=https://rpc.testnet.arc.io    # comma-separated for failover
CHAIN_ID=5042002
POOL_ADDRESS=
WEB_ORIGIN=http://localhost:5174
# A Bee node or gateway for proposal content by reference (optional).
BEE_URL=
SNAPSHOT_TTL_MS=15000
ROSTER_PAGE=200
CONTENT_TIMEOUT_MS=5000                # per-fetch timeout for BEE_URL content
