        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 0);
        assert(s.spent == 0);
    }
    // case 84: costs [5, 9, 3, 3], sealed [], budget 3
    {
        let mut s = empty_state::<8, 4>(4, 3);
        s.weights = [0, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [5, 9, 3, 3];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 0);
        assert(s.spent == 0);
    }
    // case 85: costs [5, 3], sealed [], budget 0
    {
        let mut s = empty_state::<8, 4>(2, 0);
        s.weights = [0, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [5, 3, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 0);
        assert(s.spent == 0);
    }
    // case 86: costs [8, 10, 4], sealed [(3, [0, 0, 0]), (12, [2, 1, 3]), (8, [1, 1, 3]), (4, [0, 2, 1]), (9, None)], budget 65
    {
        let mut s = empty_state::<8, 4>(3, 65);
        s.weights = [3, 12, 8, 4, 0, 0, 0, 0];
        s.ballots = [0x0, 0x30102, 0x30101, 0x10200, 0x0, 0x0, 0x0, 0x0];
        let costs = [8, 10, 4, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [18, 6, 0, 0], best: 0, total: 29 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 5, 0, 0], best: 1, total: 24 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 2, total: 6 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.funded_order[2] == 2);
        assert(s.spent == 22);
    }
    // case 87: costs [5, 10], sealed [(8, [255, 1]), (5, [1, 2]), (1, [1, 1])], budget 26
    {
        let mut s = empty_state::<8, 4>(2, 26);
        s.weights = [8, 5, 1, 0, 0, 0, 0, 0];
        s.ballots = [0x1ff, 0x201, 0x101, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [5, 10, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [9, 8, 0, 0], best: 1, total: 17 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [5, 0, 0, 0], best: 0, total: 10 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 0);
        assert(s.spent == 15);
    }
    // case 88: costs [6], sealed [(4, [0]), (0, [255])], budget 11
    {
        let mut s = empty_state::<8, 4>(1, 11);
        s.weights = [4, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0xff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [6, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [4, 0, 0, 0], best: 0, total: 8 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 6);
    }
    // case 89: costs [5, 6, 5], sealed [(3, None)], budget 22
    {
        let mut s = empty_state::<8, 4>(3, 22);
        s.weights = [0, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [5, 6, 5, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [7, 18, 7, 0], best: 1, total: 18 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [4, 0, 4, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [12, 0, 12, 0], best: 0, total: 12 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 7, 0], best: 2, total: 7 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 0);
        assert(s.funded_order[2] == 2);
        assert(s.spent == 16);
    }
}

#[test]
fn withhold_cases_9() {
    // case 90: costs [8, 5, 8], sealed [(4, [1, 3, 1]), (10, [1, 2, 0]), (1, None), (0, [255, 255, 1]), (5, [2, 1, 2]), (0, [0, 0, 0])], budget 31
    {
        let mut s = empty_state::<8, 4>(3, 31);
        s.weights = [4, 10, 0, 0, 5, 0, 0, 0];
        s.ballots = [0x10301, 0x201, 0x0, 0x1ffff, 0x20102, 0x0, 0x0, 0x0];
        let costs = [8, 5, 8, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [7, 0, 0, 0], best: 0, total: 21 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 5 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 5, 0], best: 2, total: 13 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.funded_order[2] == 2);
        assert(s.spent == 21);
    }
    // case 91: costs [7, 9], sealed [(12, [1, 255])], budget 28
    {
        let mut s = empty_state::<8, 4>(2, 28);
        s.weights = [12, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0xff01, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [7, 9, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [7, 16, 0, 0], best: 0, total: 19 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 14, 0, 0], best: 1, total: 14 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.spent == 16);
    }
    // case 92: costs [9, 7, 6], sealed [(7, [3, 1, 1]), (8, [255, 1, 2]), (4, None)], budget 30
    {
        let mut s = empty_state::<8, 4>(3, 30);
        s.weights = [7, 8, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x10103, 0x201ff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [9, 7, 6, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 5, 0], best: 1, total: 15 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 5, 0], best: 2, total: 9 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [2, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [2, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 2);
        assert(s.spent == 13);
    }
    // case 93: costs [1, 1], sealed [(3, [1, 255]), (3, [255, 255]), (2, [1, 1])], budget 29
    {
        let mut s = empty_state::<8, 4>(2, 29);
        s.weights = [3, 3, 2, 0, 0, 0, 0, 0];
        s.ballots = [0xff01, 0xffff, 0x101, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [1, 1, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [16, 5, 0, 0], best: 0, total: 21 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 5, 0, 0], best: 1, total: 6 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.spent == 2);
    }
    // case 94: costs [8], sealed [(7, [255]), (7, [1]), (6, [0]), (12, [1]), (3, [0]), (1, [1])], budget 44
    {
        let mut s = empty_state::<8, 4>(1, 44);
        s.weights = [7, 7, 6, 12, 3, 1, 0, 0];
        s.ballots = [0xff, 0x1, 0x0, 0x1, 0x0, 0x1, 0x0, 0x0];
        let costs = [8, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 29 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 8);
    }
    // case 95: costs [3], sealed [(1, [255]), (9, None), (3, [1]), (11, None)], budget 35
    {
        let mut s = empty_state::<8, 4>(1, 35);
        s.weights = [1, 0, 3, 0, 0, 0, 0, 0];
        s.ballots = [0xff, 0x0, 0x1, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [3, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [5, 0, 0, 0], best: 0, total: 8 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 3);
    }
    // case 96: costs [1, 6, 9, 10], sealed [], budget 13
    {
        let mut s = empty_state::<8, 4>(4, 13);
        s.weights = [0, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [1, 6, 9, 10];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [10, 0, 3, 12], best: 3, total: 12 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [2, 0, 1, 0], best: 0, total: 2 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 3);
        assert(s.funded_order[1] == 0);
        assert(s.spent == 11);
    }
    // case 97: costs [5, 2], sealed [(12, [2, 1]), (6, [1, 1]), (5, [1, 2])], budget 28
    {
        let mut s = empty_state::<8, 4>(2, 28);
        s.weights = [12, 6, 5, 0, 0, 0, 0, 0];
        s.ballots = [0x102, 0x101, 0x201, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [5, 2, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 18 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 10 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 0);
        assert(s.spent == 7);
    }
    // case 98: costs [7, 9], sealed [], budget 3
    {
        let mut s = empty_state::<8, 4>(2, 3);
        s.weights = [0, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [7, 9, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 0);
        assert(s.spent == 0);
    }
    // case 99: costs [8, 7, 5], sealed [(6, [0, 1, 2]), (2, [3, 1, 1]), (0, [1, 1, 3]), (10, [0, 0, 0])], budget 34
    {
        let mut s = empty_state::<8, 4>(3, 34);
        s.weights = [6, 2, 0, 10, 0, 0, 0, 0];
        s.ballots = [0x20100, 0x10103, 0x30101, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [8, 7, 5, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [11, 0, 0, 0], best: 0, total: 21 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 14 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: 2, total: 7 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.funded_order[2] == 2);
        assert(s.spent == 20);
    }
}

#[test]
fn withhold_cases_10() {
    // case 100: costs [1, 3], sealed [(5, None), (8, None), (8, [255, 255]), (5, [0, 1]), (12, None), (6, None)], budget 49
    {
        let mut s = empty_state::<8, 4>(2, 49);
        s.weights = [0, 0, 8, 5, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0xffff, 0x100, 0x0, 0x0, 0x0, 0x0];
        let costs = [1, 3, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 5 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: 0, total: 2 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 0);
        assert(s.spent == 4);
    }
    // case 101: costs [6, 6, 6, 10], sealed [(11, None), (3, [0, 0, 1, 0]), (3, [2, 2, 2, 1]), (11, None), (2, [2, 4, 1, 3]), (4, [1, 3, 0, 1])], budget 51
    {
        let mut s = empty_state::<8, 4>(4, 51);
        s.weights = [0, 3, 3, 0, 2, 4, 0, 0];
        s.ballots = [0x0, 0x10000, 0x1020202, 0x0, 0x3010402, 0x1000301, 0x0, 0x0];
        let costs = [6, 6, 6, 10];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [5, 0, 0, 0], best: 0, total: 9 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 2, 2, 0], best: 2, total: 10 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 1, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 1, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 1, 0, 1], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 2);
        assert(s.spent == 12);
    }
    // case 102: costs [5], sealed [(5, None), (4, None), (11, [255]), (8, [1]), (5, None)], budget 62
    {
        let mut s = empty_state::<8, 4>(1, 62);
        s.weights = [0, 0, 11, 8, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0xff, 0x1, 0x0, 0x0, 0x0, 0x0];
        let costs = [5, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [28, 0, 0, 0], best: 0, total: 36 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 5);
    }
    // case 103: costs [7], sealed [(2, [1]), (0, [1]), (7, [0]), (0, None), (7, [1]), (5, [1]), (1, [255])], budget 30
    {
        let mut s = empty_state::<8, 4>(1, 30);
        s.weights = [2, 0, 7, 0, 7, 5, 1, 0];
        s.ballots = [0x1, 0x1, 0x0, 0x0, 0x1, 0x1, 0xff, 0x0];
        let costs = [7, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [7, 0, 0, 0], best: 0, total: 28 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 7);
    }
    // case 104: costs [1], sealed [(5, [0]), (0, [255]), (8, [1]), (7, [0]), (11, None), (11, [255]), (3, [1]), (3, [0])], budget 53
    {
        let mut s = empty_state::<8, 4>(1, 53);
        s.weights = [5, 0, 8, 7, 0, 11, 3, 3];
        s.ballots = [0x0, 0xff, 0x1, 0x0, 0x0, 0xff, 0x1, 0x0];
        let costs = [1, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 26 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 1);
    }
    // case 105: costs [5, 6], sealed [(11, [1, 1]), (7, [255, 255]), (8, [1, 255]), (10, [0, 0]), (1, [0, 0]), (2, [255, 1]), (2, [255, 1])], budget 63
    {
        let mut s = empty_state::<8, 4>(2, 63);
        s.weights = [11, 7, 8, 10, 1, 2, 2, 0];
        s.ballots = [0x101, 0xffff, 0xff01, 0x0, 0x0, 0x1ff, 0x1ff, 0x0];
        let costs = [5, 6, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [1, 18, 0, 0], best: 1, total: 44 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [1, 0, 0, 0], best: 0, total: 28 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 0);
        assert(s.spent == 11);
    }
    // case 106: costs [5], sealed [(5, [1]), (6, [255]), (6, None), (4, [1]), (7, [1])], budget 39
    {
        let mut s = empty_state::<8, 4>(1, 39);
        s.weights = [5, 6, 0, 4, 7, 0, 0, 0];
        s.ballots = [0x1, 0xff, 0x0, 0x1, 0x1, 0x0, 0x0, 0x0];
        let costs = [5, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [5, 0, 0, 0], best: 0, total: 21 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 5);
    }
    // case 107: costs [1, 8, 4, 5], sealed [(5, None), (12, None), (6, [1, 255, 0, 255]), (9, None), (9, [1, 0, 255, 255])], budget 47
    {
        let mut s = empty_state::<8, 4>(4, 47);
        s.weights = [0, 0, 6, 0, 9, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0xff00ff01, 0x0, 0xffff0001, 0x0, 0x0, 0x0];
        let costs = [1, 8, 4, 5];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [1, 1, 1, 1], best: 0, total: 16 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 1, 1, 1], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 1, 1, 1], best: 1, total: 9 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 1, 1], best: 2, total: 7 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 1], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 1], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 0, 1], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.funded_order[2] == 2);
        assert(s.spent == 13);
    }
    // case 108: costs [6], sealed [(1, [0])], budget 11
    {
        let mut s = empty_state::<8, 4>(1, 11);
        s.weights = [1, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [6, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [6, 0, 0, 0], best: 0, total: 7 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 6);
    }
    // case 109: costs [9, 6, 8, 3], sealed [(1, [2, 0, 0, 1]), (3, [255, 255, 0, 0]), (4, [0, 1, 1, 0]), (10, None), (3, [3, 4, 2, 1])], budget 21
    {
        let mut s = empty_state::<8, 4>(4, 21);
        s.weights = [1, 3, 4, 0, 3, 0, 0, 0];
        s.ballots = [0x1000002, 0xffff, 0x10100, 0x0, 0x1020403, 0x0, 0x0, 0x0];
        let costs = [9, 6, 8, 3];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 3, total: 7 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: 2, total: 8 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 3);
        assert(s.funded_order[1] == 2);
        assert(s.spent == 11);
    }
}

#[test]
fn withhold_cases_11() {
    // case 110: costs [10, 8, 6, 9], sealed [(11, None), (9, [3, 4, 1, 1])], budget 36
    {
        let mut s = empty_state::<8, 4>(4, 36);
        s.weights = [0, 9, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x1010403, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [10, 8, 6, 9];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [7, 7, 8, 7], best: 2, total: 17 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [7, 7, 0, 7], best: 3, total: 12 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [2, 2, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [8, 8, 0, 0], best: 1, total: 8 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 2);
        assert(s.funded_order[1] == 3);
        assert(s.funded_order[2] == 1);
        assert(s.spent == 23);
    }
    // case 111: costs [10], sealed [(10, [1]), (8, [0]), (7, [1]), (12, [0])], budget 61
    {
        let mut s = empty_state::<8, 4>(1, 61);
        s.weights = [10, 8, 7, 12, 0, 0, 0, 0];
        s.ballots = [0x1, 0x0, 0x1, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [10, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [18, 0, 0, 0], best: 0, total: 55 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 10);
    }
    // case 112: costs [10, 2, 5], sealed [(8, [1, 2, 255])], budget 11
    {
        let mut s = empty_state::<8, 4>(3, 11);
        s.weights = [8, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0xff0201, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [10, 2, 5, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [2, 0, 0, 0], best: 0, total: 10 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 10);
    }
    // case 113: costs [5, 8, 3], sealed [(6, [255, 0, 1]), (8, [0, 1, 1]), (0, [255, 255, 255])], budget 22
    {
        let mut s = empty_state::<8, 4>(3, 22);
        s.weights = [6, 8, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x100ff, 0x10100, 0xffffff, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [5, 8, 3, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 1, 0, 0], best: 2, total: 14 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 1, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 1, 0, 0], best: 1, total: 12 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [1, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 2);
        assert(s.funded_order[1] == 1);
        assert(s.spent == 11);
    }
    // case 114: costs [1, 6, 7, 2], sealed [], budget 5
    {
        let mut s = empty_state::<8, 4>(4, 5);
        s.weights = [0, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [1, 6, 7, 2];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 0);
        assert(s.spent == 0);
    }
    // case 115: costs [10, 2], sealed [(11, [1, 0]), (0, None)], budget 35
    {
        let mut s = empty_state::<8, 4>(2, 35);
        s.weights = [11, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [10, 2, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [4, 13, 0, 0], best: 0, total: 15 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 11, 0, 0], best: 1, total: 11 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.spent == 12);
    }
    // case 116: costs [1, 10, 6, 8], sealed [(10, [3, 2, 1, 4]), (12, [255, 255, 1, 255]), (9, [1, 3, 1, 255]), (6, [2, 1, 3, 255]), (1, [255, 255, 255, 1]), (9, [255, 3, 1, 2])], budget 54
    {
        let mut s = empty_state::<8, 4>(4, 54);
        s.weights = [10, 12, 9, 6, 1, 9, 0, 0];
        s.ballots = [0x4010203, 0xff01ffff, 0xff010301, 0xff030102, 0x1ffffff, 0x20103ff, 0x0, 0x0];
        let costs = [1, 10, 6, 8];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [3, 3, 3, 3], best: 2, total: 43 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [3, 3, 0, 3], best: 0, total: 11 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 3, 0, 3], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 3, 0, 3], best: 1, total: 18 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 2], best: 3, total: 10 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 2);
        assert(s.funded_order[1] == 0);
        assert(s.funded_order[2] == 1);
        assert(s.funded_order[3] == 3);
        assert(s.spent == 25);
    }
    // case 117: costs [8, 2], sealed [(5, [1, 1]), (1, [2, 1]), (6, None), (1, None), (4, [255, 1]), (12, [1, 1]), (1, [255, 1]), (3, [1, 0])], budget 45
    {
        let mut s = empty_state::<8, 4>(2, 45);
        s.weights = [5, 1, 0, 0, 4, 12, 1, 3];
        s.ballots = [0x101, 0x102, 0x0, 0x0, 0x1ff, 0x101, 0x1ff, 0x1];
        let costs = [8, 2, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [8, 3, 0, 0], best: 0, total: 28 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 3, 0, 0], best: 1, total: 21 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.spent == 10);
    }
    // case 118: costs [9, 10, 4, 9], sealed [(11, None), (3, None), (5, None), (0, [255, 255, 255, 255]), (5, [255, 255, 255, 1]), (11, None), (9, [4, 3, 1, 1]), (6, [0, 0, 0, 0])], budget 54
    {
        let mut s = empty_state::<8, 4>(4, 54);
        s.weights = [0, 0, 0, 0, 5, 0, 9, 6];
        s.ballots = [0x0, 0x0, 0x0, 0xffffffff, 0x1ffffff, 0x0, 0x1010304, 0x0];
        let costs = [9, 10, 4, 9];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 3, total: 20 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 2, total: 8 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 3);
        assert(s.funded_order[1] == 2);
        assert(s.spent == 13);
    }
    // case 119: costs [1, 7, 10], sealed [(8, [1, 0, 0]), (2, None), (10, [0, 1, 0]), (1, None), (9, [1, 2, 255]), (5, [1, 2, 2])], budget 56
    {
        let mut s = empty_state::<8, 4>(3, 56);
        s.weights = [8, 0, 10, 0, 9, 5, 0, 0];
        s.ballots = [0x1, 0x0, 0x100, 0x0, 0xff0201, 0x20201, 0x0, 0x0];
        let costs = [1, 7, 10, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 12, 0, 0], best: 0, total: 22 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 12, 0, 0], best: 1, total: 22 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 9, 0], best: 2, total: 27 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.funded_order[2] == 2);
        assert(s.spent == 18);
    }
}
