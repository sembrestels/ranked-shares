        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 20 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 15 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 2);
        assert(s.funded_order[1] == 0);
        assert(s.funded_order[2] == 1);
        assert(s.spent == 10);
    }
    // case 82: costs [2, 6, 9, 8], sealed [(8, [0, 2, 1, 0]), (12, [0, 0, 255, 0]), (9, [1, 3, 1, 0]), (0, [255, 2, 1, 3])], budget 41
    {
        let mut s = empty_state::<8, 4>(4, 41);
        s.weights = [8, 12, 9, 0, 0, 0, 0, 0];
        s.ballots = [0x10200, 0xff0000, 0x10301, 0x30102ff, 0x0, 0x0, 0x0, 0x0];
        let costs = [2, 6, 9, 8];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 11, 11, 0], best: 2, total: 28 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 8, 0, 0], best: 1, total: 20 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 14 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: 3, total: 12 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 2);
        assert(s.funded_order[1] == 1);
        assert(s.funded_order[2] == 0);
        assert(s.funded_order[3] == 3);
        assert(s.spent == 25);
    }
    // case 83: costs [10], sealed [(4, [1])], budget 15
    {
        let mut s = empty_state::<8, 4>(1, 15);
        s.weights = [4, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [10, 0, 0, 0];
        let ranks = ranks_of(s);
