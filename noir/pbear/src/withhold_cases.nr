#[test]
fn withhold_cases_1() {
    // case 10: costs [2, 8], sealed [], budget 7
    {
        let mut s = empty_state::<8, 4>(2, 7);
        s.weights = [0, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [2, 8, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [4, 3, 0, 0], best: 0, total: 4 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 2);
    }
    // case 11: costs [3, 1, 8], sealed [(9, [2, 1, 0]), (12, [1, 2, 2]), (2, [255, 255, 255]), (12, [0, 0, 0])], budget 52
    {
        let mut s = empty_state::<8, 4>(3, 52);
        s.weights = [9, 12, 2, 12, 0, 0, 0, 0];
        s.ballots = [0x102, 0x20201, 0xffffff, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [3, 1, 8, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [11, 9, 0, 0], best: 0, total: 35 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 9, 0, 0], best: 1, total: 28 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 2, total: 9 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.funded_order[2] == 2);
        assert(s.spent == 12);
    }
    // case 12: costs [5, 6, 1, 2], sealed [(3, [0, 255, 1, 1]), (1, [0, 0, 2, 1]), (11, [2, 0, 0, 1]), (5, [0, 0, 0, 1])], budget 38
    {
        let mut s = empty_state::<8, 4>(4, 38);
        s.weights = [3, 1, 11, 5, 0, 0, 0, 0];
        s.ballots = [0x101ff00, 0x1020000, 0x1000002, 0x1000000, 0x0, 0x0, 0x0, 0x0];
        let costs = [5, 6, 1, 2];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 12], best: 3, total: 32 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 2, total: 3 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [12, 0, 0, 0], best: 0, total: 27 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: 1, total: 12 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 3);
        assert(s.funded_order[1] == 2);
        assert(s.funded_order[2] == 0);
        assert(s.funded_order[3] == 1);
        assert(s.spent == 14);
    }
    // case 13: costs [8, 2, 4, 1], sealed [], budget 18
    {
        let mut s = empty_state::<8, 4>(4, 18);
        s.weights = [0, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [8, 2, 4, 1];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [8, 0, 0, 0], best: 0, total: 8 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
