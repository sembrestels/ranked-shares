        let costs = [7, 6, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [9, 9, 0, 0], best: 0, total: 18 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 6, 0, 0], best: 1, total: 11 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.spent == 13);
    }
    // case 21: costs [10], sealed [(3, [0]), (0, None), (10, [1]), (4, None), (2, [255]), (8, [0]), (4, [1]), (1, [255])], budget 51
    {
        let mut s = empty_state::<8, 4>(1, 51);
        s.weights = [3, 0, 10, 0, 2, 8, 4, 1];
        s.ballots = [0x0, 0x0, 0x1, 0x0, 0xff, 0x0, 0x1, 0xff];
        let costs = [10, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [11, 0, 0, 0], best: 0, total: 36 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 10);
    }
    // case 22: costs [5, 1, 9, 6], sealed [(5, [0, 0, 0, 0]), (4, [2, 1, 2, 2]), (2, [2, 2, 1, 4]), (5, [2, 3, 255, 1]), (0, [1, 255, 255, 1]), (1, [1, 0, 255, 255]), (1, [255, 255, 1, 255]), (0, [0, 0, 0, 255])], budget 49
    {
        let mut s = empty_state::<8, 4>(4, 49);
        s.weights = [5, 4, 2, 5, 0, 1, 1, 0];
        s.ballots = [0x0, 0x2020102, 0x4010202, 0x1ff0302, 0x1ffff01, 0xffff0001, 0xff01ffff, 0xff000000];
        let costs = [5, 1, 9, 6];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [8, 17, 0, 0], best: 1, total: 26 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [8, 0, 0, 0], best: 0, total: 14 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 3, total: 8 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 6, 0], best: 2, total: 13 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 0);
        assert(s.funded_order[2] == 3);
        assert(s.funded_order[3] == 2);
        assert(s.spent == 21);
    }
    // case 23: costs [2, 4, 10, 7], sealed [(9, [1, 1, 1, 0]), (11, [2, 0, 255, 1]), (5, [255, 255, 255, 255]), (3, [1, 1, 255, 3])], budget 57
    {
        let mut s = empty_state::<8, 4>(4, 57);
        s.weights = [9, 11, 5, 3, 0, 0, 0, 0];
        s.ballots = [0x10101, 0x1ff0002, 0xffffffff, 0x3ff0101, 0x0, 0x0, 0x0, 0x0];
        let costs = [2, 4, 10, 7];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [10, 10, 12, 10], best: 0, total: 22 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 10, 12, 10], best: 3, total: 21 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 7, 9, 0], best: 1, total: 17 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 8, 0], best: 2, total: 14 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 3);
        assert(s.funded_order[2] == 1);
        assert(s.funded_order[3] == 2);
        assert(s.spent == 23);
    }
    // case 24: costs [8, 3, 3, 9], sealed [(12, None), (1, [255, 255, 1, 255]), (3, [255, 255, 255, 1]), (2, [255, 1, 255, 1]), (6, [1, 0, 2, 0]), (9, [4, 1, 1, 1]), (12, [2, 1, 4, 3])], budget 60
    {
        let mut s = empty_state::<8, 4>(4, 60);
        s.weights = [0, 1, 3, 2, 6, 9, 12, 0];
        s.ballots = [0x0, 0xff01ffff, 0x1ffffff, 0x1ff01ff, 0x20001, 0x1010104, 0x3040102, 0x0];
        let costs = [8, 3, 3, 9];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 8, 6, 0], best: 1, total: 31 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 6, 0], best: 2, total: 15 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 3, total: 11 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [13, 0, 0, 0], best: 0, total: 29 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 2);
        assert(s.funded_order[2] == 3);
        assert(s.funded_order[3] == 0);
        assert(s.spent == 23);
    }
    // case 25: costs [6, 7, 2, 10], sealed [(11, [1, 0, 0, 0]), (7, [1, 1, 3, 255]), (7, [255, 255, 255, 255])], budget 29
    {
        let mut s = empty_state::<8, 4>(4, 29);
        s.weights = [11, 7, 7, 0, 0, 0, 0, 0];
        s.ballots = [0x1, 0xff030101, 0xffffffff, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [6, 7, 2, 10];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 3, 3, 0], best: 0, total: 18 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 3, 3, 0], best: 1, total: 7 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: 2, total: 8 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.funded_order[2] == 2);
        assert(s.spent == 15);
    }
    // case 26: costs [7, 1, 10], sealed [(10, [255, 255, 1]), (0, [1, 255, 255]), (11, [255, 1, 255])], budget 30
    {
        let mut s = empty_state::<8, 4>(3, 30);
        s.weights = [10, 0, 11, 0, 0, 0, 0, 0];
        s.ballots = [0x1ffff, 0xffff01, 0xff01ff, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [7, 1, 10, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [9, 6, 6, 0], best: 1, total: 17 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [9, 0, 6, 0], best: 2, total: 16 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [6, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [6, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [6, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 2);
        assert(s.spent == 11);
    }
    // case 27: costs [5], sealed [(2, [1]), (1, None), (2, [1])], budget 7
    {
        let mut s = empty_state::<8, 4>(1, 7);
        s.weights = [2, 0, 2, 0, 0, 0, 0, 0];
        s.ballots = [0x1, 0x0, 0x1, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [5, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 0);
        assert(s.spent == 0);
    }
    // case 28: costs [1, 5, 1, 5], sealed [(10, [0, 0, 0, 1]), (8, [2, 4, 1, 2]), (7, [1, 1, 4, 1]), (6, None)], budget 37
    {
        let mut s = empty_state::<8, 4>(4, 37);
        s.weights = [10, 8, 7, 0, 0, 0, 0, 0];
        s.ballots = [0x1000000, 0x2010402, 0x1040101, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [1, 5, 1, 5];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [1, 0, 1, 0], best: 3, total: 17 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [1, 0, 1, 0], best: 2, total: 9 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [1, 0, 0, 0], best: 0, total: 5 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: 1, total: 11 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 3);
        assert(s.funded_order[1] == 2);
        assert(s.funded_order[2] == 0);
        assert(s.funded_order[3] == 1);
        assert(s.spent == 12);
    }
    // case 29: costs [4, 4], sealed [], budget 3
    {
        let mut s = empty_state::<8, 4>(2, 3);
        s.weights = [0, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [4, 4, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 0);
        assert(s.spent == 0);
    }
}

#[test]
fn withhold_cases_3() {
    // case 30: costs [8, 9], sealed [(4, [2, 1]), (6, [0, 1]), (5, [1, 1]), (0, [255, 0]), (1, [255, 255])], budget 19
    {
        let mut s = empty_state::<8, 4>(2, 19);
        s.weights = [4, 6, 5, 0, 1, 0, 0, 0];
        s.ballots = [0x102, 0x100, 0x101, 0xff, 0xffff, 0x0, 0x0, 0x0];
        let costs = [8, 9, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 15 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 1);
        assert(s.spent == 9);
    }
    // case 31: costs [7, 10, 8, 3], sealed [(10, [255, 255, 255, 255]), (4, [3, 3, 1, 1]), (5, [255, 2, 1, 255]), (9, [3, 1, 0, 1]), (2, [3, 1, 4, 1]), (9, [1, 1, 1, 4]), (6, [0, 0, 0, 0]), (6, [2, 4, 3, 1])], budget 57
    {
        let mut s = empty_state::<8, 4>(4, 57);
        s.weights = [10, 4, 5, 9, 2, 9, 6, 6];
        s.ballots = [0xffffffff, 0x1010303, 0xff0102ff, 0x1000103, 0x1040103, 0x4010101, 0x0, 0x1030402];
        let costs = [7, 10, 8, 3];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 3, total: 27 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 24 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 2, total: 17 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: 0, total: 9 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 3);
        assert(s.funded_order[1] == 1);
        assert(s.funded_order[2] == 2);
        assert(s.funded_order[3] == 0);
        assert(s.spent == 28);
    }
    // case 32: costs [8, 9, 9, 2], sealed [(0, [0, 0, 255, 1]), (5, None), (5, [2, 4, 2, 1]), (8, None), (1, [255, 255, 1, 1])], budget 20
    {
        let mut s = empty_state::<8, 4>(4, 20);
        s.weights = [0, 0, 5, 0, 1, 0, 0, 0];
        s.ballots = [0x1ff0000, 0x0, 0x1020402, 0x0, 0x101ffff, 0x0, 0x0, 0x0];
        let costs = [8, 9, 9, 2];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 3, total: 6 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 3);
        assert(s.spent == 2);
    }
    // case 33: costs [8, 1, 5, 8], sealed [(2, [1, 0, 0, 0])], budget 15
    {
        let mut s = empty_state::<8, 4>(4, 15);
        s.weights = [2, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [8, 1, 5, 8];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [8, 5, 5, 5], best: 0, total: 10 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 1, 1, 1], best: 1, total: 1 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 1, 1], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 1, 1], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 1, 1], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.spent == 9);
    }
    // case 34: costs [5, 3, 4, 10], sealed [(2, [4, 1, 2, 3]), (0, [255, 1, 255, 255]), (10, [0, 0, 0, 1]), (6, [255, 255, 255, 255]), (1, [1, 255, 255, 255])], budget 31
    {
        let mut s = empty_state::<8, 4>(4, 31);
        s.weights = [2, 0, 10, 6, 1, 0, 0, 0];
        s.ballots = [0x3020104, 0xffff01ff, 0x1000000, 0xffffffff, 0xffffff01, 0x0, 0x0, 0x0];
        let costs = [5, 3, 4, 10];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [12, 12, 0, 0], best: 1, total: 14 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [10, 0, 0, 0], best: 0, total: 11 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 3, total: 10 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 0);
        assert(s.funded_order[2] == 3);
        assert(s.spent == 18);
    }
    // case 35: costs [8, 1, 5], sealed [], budget 21
    {
        let mut s = empty_state::<8, 4>(3, 21);
        s.weights = [0, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [8, 1, 5, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [4, 14, 0, 0], best: 1, total: 14 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [3, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [13, 0, 10, 0], best: 0, total: 13 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 4, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 5, 0], best: 2, total: 5 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 0);
        assert(s.funded_order[2] == 2);
        assert(s.spent == 14);
    }
    // case 36: costs [6, 8, 8, 2], sealed [(8, [1, 0, 0, 0])], budget 34
    {
        let mut s = empty_state::<8, 4>(4, 34);
        s.weights = [8, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [6, 8, 8, 2];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [24, 12, 0, 17], best: 0, total: 32 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 10, 0, 15], best: 3, total: 15 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 10, 0, 0], best: 1, total: 10 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 8, 0], best: 2, total: 14 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 3);
        assert(s.funded_order[2] == 1);
        assert(s.funded_order[3] == 2);
        assert(s.spent == 24);
    }
    // case 37: costs [5, 1], sealed [(2, [0, 0]), (11, [1, 1]), (6, [1, 2]), (3, None), (8, None), (11, [0, 0])], budget 57
    {
        let mut s = empty_state::<8, 4>(2, 57);
        s.weights = [2, 11, 6, 0, 0, 11, 0, 0];
        s.ballots = [0x0, 0x101, 0x201, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [5, 1, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [12, 11, 0, 0], best: 0, total: 42 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 10, 0, 0], best: 1, total: 31 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.spent == 6);
    }
    // case 38: costs [1, 3, 10, 4], sealed [(2, [1, 255, 0, 255]), (1, [3, 2, 3, 1]), (10, None), (5, [1, 255, 0, 0]), (4, [0, 1, 0, 0]), (11, None), (10, [255, 255, 255, 255])], budget 55
    {
        let mut s = empty_state::<8, 4>(4, 55);
        s.weights = [2, 1, 0, 5, 4, 0, 10, 0];
        s.ballots = [0xff00ff01, 0x1030203, 0x0, 0xff01, 0x100, 0x0, 0xffffffff, 0x0];
        let costs = [1, 3, 10, 4];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [8, 8, 8, 8], best: 0, total: 15 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 8, 8, 8], best: 1, total: 12 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 6, 6], best: 3, total: 7 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 3, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 3, 0], best: 2, total: 12 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.funded_order[2] == 3);
        assert(s.funded_order[3] == 2);
        assert(s.spent == 18);
    }
    // case 39: costs [1, 4, 6, 7], sealed [(5, [2, 1, 255, 255]), (12, [0, 0, 1, 0]), (10, [4, 3, 1, 1]), (4, [255, 0, 255, 255])], budget 44
    {
        let mut s = empty_state::<8, 4>(4, 44);
        s.weights = [5, 12, 10, 4, 0, 0, 0, 0];
        s.ballots = [0xffff0102, 0x10000, 0x1010304, 0xffff00ff, 0x0, 0x0, 0x0, 0x0];
        let costs = [1, 4, 6, 7];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 13], best: 3, total: 23 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 2, total: 18 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 9 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: 0, total: 11 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 3);
        assert(s.funded_order[1] == 2);
        assert(s.funded_order[2] == 1);
        assert(s.funded_order[3] == 0);
        assert(s.spent == 18);
    }
}

#[test]
fn withhold_cases_4() {
    // case 40: costs [9, 2], sealed [(0, [0, 0]), (3, [1, 255]), (2, [1, 1]), (7, [1, 255]), (7, [0, 0]), (3, None), (11, [0, 0]), (3, [255, 255])], budget 49
    {
        let mut s = empty_state::<8, 4>(2, 49);
        s.weights = [0, 3, 2, 7, 7, 0, 11, 3];
        s.ballots = [0x0, 0xff01, 0x101, 0xff01, 0x0, 0x0, 0x0, 0xffff];
        let costs = [9, 2, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 30 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 13 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.spent == 11);
    }
    // case 41: costs [3, 8], sealed [(2, [255, 255]), (6, [1, 1]), (9, [0, 0]), (5, [0, 1]), (11, None), (5, [0, 0]), (4, [255, 1]), (5, [0, 1])], budget 56
    {
        let mut s = empty_state::<8, 4>(2, 56);
        s.weights = [2, 6, 9, 5, 0, 5, 4, 5];
        s.ballots = [0xffff, 0x101, 0x0, 0x100, 0x0, 0x0, 0x1ff, 0x100];
        let costs = [3, 8, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 4, 0, 0], best: 1, total: 38 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 15 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 0);
        assert(s.spent == 11);
    }
    // case 42: costs [1, 4, 8], sealed [(7, [0, 0, 1]), (3, [1, 255, 2])], budget 16
    {
        let mut s = empty_state::<8, 4>(3, 16);
        s.weights = [7, 3, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x10000, 0x2ff01, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [1, 4, 8, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 3, 0, 0], best: 0, total: 3 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 3, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 3, 0, 0], best: 1, total: 10 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.spent == 5);
    }
    // case 43: costs [7, 9, 5, 2], sealed [(5, [3, 1, 3, 2]), (8, [255, 2, 1, 255]), (12, [255, 0, 255, 255]), (2, [0, 255, 255, 255]), (2, [1, 0, 0, 1]), (9, [4, 3, 1, 2])], budget 40
    {
        let mut s = empty_state::<8, 4>(4, 40);
        s.weights = [5, 8, 12, 2, 2, 9, 0, 0];
        s.ballots = [0x2030103, 0xff0102ff, 0xffff00ff, 0xffffff00, 0x1000001, 0x2010304, 0x0, 0x0];
        let costs = [7, 9, 5, 2];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 2, total: 17 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 17 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 3, total: 2 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 0, 0], best: 0, total: 11 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 2);
        assert(s.funded_order[1] == 1);
        assert(s.funded_order[2] == 3);
        assert(s.funded_order[3] == 0);
        assert(s.spent == 23);
    }
    // case 44: costs [3, 7], sealed [(11, [255, 0])], budget 17
    {
        let mut s = empty_state::<8, 4>(2, 17);
        s.weights = [11, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0xff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [3, 7, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 11 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 1);
        assert(s.spent == 7);
    }
    // case 45: costs [9, 8, 3, 9], sealed [(4, [0, 0, 1, 0]), (9, [2, 1, 2, 2]), (8, [255, 255, 1, 1]), (6, [255, 255, 255, 1]), (12, [0, 0, 1, 2]), (8, [255, 255, 255, 255]), (9, [0, 0, 0, 0]), (12, [255, 255, 255, 255])], budget 69
    {
        let mut s = empty_state::<8, 4>(4, 69);
        s.weights = [4, 9, 8, 6, 12, 8, 9, 12];
        s.ballots = [0x10000, 0x2020102, 0x101ffff, 0x1ffffff, 0x2010000, 0xffffffff, 0x0, 0xffffffff];
        let costs = [9, 8, 3, 9];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 2, total: 33 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 3, total: 21 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 13 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: 0, total: 9 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 2);
        assert(s.funded_order[1] == 3);
        assert(s.funded_order[2] == 1);
        assert(s.funded_order[3] == 0);
        assert(s.spent == 29);
    }
    // case 46: costs [10], sealed [(10, [1]), (10, None)], budget 36
    {
        let mut s = empty_state::<8, 4>(1, 36);
        s.weights = [10, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [10, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [13, 0, 0, 0], best: 0, total: 23 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 10);
    }
    // case 47: costs [2], sealed [(8, [1])], budget 17
    {
        let mut s = empty_state::<8, 4>(1, 17);
        s.weights = [8, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [2, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 8 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 2);
    }
    // case 48: costs [9, 7, 4, 8], sealed [(2, None), (10, None), (7, [255, 1, 0, 2]), (3, [1, 0, 0, 0]), (10, [0, 255, 255, 255]), (4, None)], budget 56
    {
        let mut s = empty_state::<8, 4>(4, 56);
        s.weights = [0, 0, 7, 3, 10, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x20001ff, 0x1, 0xffffff00, 0x0, 0x0, 0x0];
        let costs = [9, 7, 4, 8];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [13, 11, 13, 13], best: 0, total: 26 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 7, 9, 9], best: 1, total: 14 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 6, 6], best: 2, total: 6 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 2], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 2], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 2], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 0, 2], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.funded_order[2] == 2);
        assert(s.spent == 20);
    }
    // case 49: costs [9, 2, 9], sealed [], budget 7
    {
        let mut s = empty_state::<8, 4>(3, 7);
        s.weights = [0, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [9, 2, 9, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 5, 0, 0], best: 1, total: 5 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 1);
        assert(s.spent == 2);
    }
}

#[test]
fn withhold_cases_5() {
    // case 50: costs [6, 6], sealed [(1, None), (5, [1, 0]), (8, [0, 1]), (4, [255, 255]), (6, [255, 1]), (11, [1, 1]), (12, [255, 1]), (7, [1, 1])], budget 77
    {
        let mut s = empty_state::<8, 4>(2, 77);
        s.weights = [0, 5, 8, 4, 6, 11, 12, 7];
        s.ballots = [0x0, 0x1, 0x100, 0xffff, 0x1ff, 0x101, 0x1ff, 0x101];
        let costs = [6, 6, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [9, 9, 0, 0], best: 1, total: 53 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [8, 0, 0, 0], best: 0, total: 29 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 0);
        assert(s.spent == 12);
    }
    // case 51: costs [8], sealed [(7, [1]), (10, [1]), (4, None), (12, [0]), (0, [255]), (8, [0]), (11, [255]), (6, [0])], budget 63
    {
        let mut s = empty_state::<8, 4>(1, 63);
        s.weights = [7, 10, 0, 12, 0, 8, 11, 6];
        s.ballots = [0x1, 0x1, 0x0, 0x0, 0xff, 0x0, 0xff, 0x0];
        let costs = [8, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 43 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 8);
    }
    // case 52: costs [3, 2, 5, 8], sealed [(8, [0, 0, 0, 1]), (6, [1, 255, 255, 255]), (12, [2, 1, 4, 3]), (1, [0, 0, 0, 0]), (12, [255, 255, 1, 255]), (11, [0, 0, 0, 0]), (5, None)], budget 88
    {
        let mut s = empty_state::<8, 4>(4, 88);
        s.weights = [8, 6, 12, 1, 12, 11, 0, 0];
        s.ballots = [0x1000000, 0xffffff01, 0x3040102, 0x0, 0xff01ffff, 0x0, 0x0, 0x0];
        let costs = [3, 2, 5, 8];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 19, 0, 0], best: 1, total: 43 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 2, total: 23 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 3, total: 16 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 10 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 2);
        assert(s.funded_order[2] == 3);
        assert(s.funded_order[3] == 0);
        assert(s.spent == 18);
    }
    // case 53: costs [9, 2], sealed [(0, [255, 1]), (7, [255, 1]), (5, [0, 0])], budget 17
    {
        let mut s = empty_state::<8, 4>(2, 17);
        s.weights = [0, 7, 5, 0, 0, 0, 0, 0];
        s.ballots = [0x1ff, 0x1ff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [9, 2, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 12 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 1);
        assert(s.spent == 2);
    }
    // case 54: costs [1, 8, 3], sealed [(1, None), (1, [1, 255, 255]), (4, None)], budget 25
    {
        let mut s = empty_state::<8, 4>(3, 25);
        s.weights = [0, 1, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0xffff01, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [1, 8, 3, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 1 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 1);
    }
    // case 55: costs [3, 6], sealed [(2, None), (3, None), (10, [1, 1]), (0, None)], budget 33
    {
        let mut s = empty_state::<8, 4>(2, 33);
        s.weights = [0, 0, 10, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x101, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [3, 6, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [9, 0, 0, 0], best: 0, total: 19 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 8 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.spent == 9);
    }
    // case 56: costs [3, 3], sealed [(8, [2, 1]), (1, None), (8, [1, 0]), (3, [0, 1]), (3, [1, 1]), (4, [2, 1]), (6, [255, 255])], budget 51
    {
        let mut s = empty_state::<8, 4>(2, 51);
        s.weights = [8, 0, 8, 3, 3, 4, 6, 0];
        s.ballots = [0x102, 0x0, 0x1, 0x100, 0x101, 0x102, 0xffff, 0x0];
        let costs = [3, 3, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [13, 0, 0, 0], best: 0, total: 24 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 17 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.spent == 6);
    }
    // case 57: costs [8, 3, 5, 7], sealed [(10, [255, 255, 1, 1]), (4, [0, 2, 0, 1]), (6, [255, 0, 0, 255])], budget 20
    {
        let mut s = empty_state::<8, 4>(4, 20);
        s.weights = [10, 4, 6, 0, 0, 0, 0, 0];
        s.ballots = [0x101ffff, 0x1000200, 0xff0000ff, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [8, 3, 5, 7];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 2, total: 16 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 3, total: 11 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 4 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 2);
        assert(s.funded_order[1] == 3);
        assert(s.funded_order[2] == 1);
        assert(s.spent == 15);
    }
    // case 58: costs [2, 5, 1, 4], sealed [(3, [1, 255, 255, 2]), (0, [4, 2, 2, 1]), (8, [3, 0, 2, 1])], budget 17
    {
        let mut s = empty_state::<8, 4>(4, 17);
        s.weights = [3, 0, 8, 0, 0, 0, 0, 0];
        s.ballots = [0x2ffff01, 0x1020204, 0x1020003, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [2, 5, 1, 4];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 3, total: 8 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 3 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: 2, total: 4 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 3);
        assert(s.funded_order[1] == 0);
        assert(s.funded_order[2] == 2);
        assert(s.spent == 7);
    }
    // case 59: costs [10], sealed [(1, [1]), (1, [1]), (1, [1]), (10, [1]), (1, [1]), (9, [0])], budget 41
    {
        let mut s = empty_state::<8, 4>(1, 41);
        s.weights = [1, 1, 1, 10, 1, 9, 0, 0];
        s.ballots = [0x1, 0x1, 0x1, 0x1, 0x1, 0x0, 0x0, 0x0];
        let costs = [10, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [10, 0, 0, 0], best: 0, total: 33 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 10);
    }
}

#[test]
fn withhold_cases_6() {
    // case 60: costs [10, 5, 3, 9], sealed [(0, [255, 2, 3, 1]), (3, [2, 2, 2, 1]), (6, [2, 1, 3, 4]), (1, None), (2, [0, 1, 0, 2]), (8, [255, 0, 255, 0])], budget 23
    {
        let mut s = empty_state::<8, 4>(4, 23);
        s.weights = [0, 3, 6, 0, 2, 8, 0, 0];
        s.ballots = [0x10302ff, 0x1020202, 0x4030102, 0x0, 0x2000100, 0xff00ff, 0x0, 0x0];
        let costs = [10, 5, 3, 9];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 16 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: 3, total: 9 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: 2, total: 5 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 3);
        assert(s.funded_order[2] == 2);
        assert(s.spent == 17);
    }
    // case 61: costs [8, 7, 1, 2], sealed [(9, [255, 255, 255, 255]), (9, [3, 4, 2, 1]), (2, [255, 255, 1, 2]), (0, [2, 2, 0, 1]), (9, [0, 255, 2, 1]), (8, [1, 4, 3, 1]), (9, [255, 1, 1, 1]), (5, [4, 3, 2, 1])], budget 51
    {
        let mut s = empty_state::<8, 4>(4, 51);
        s.weights = [9, 9, 2, 0, 9, 8, 9, 5];
        s.ballots = [0xffffffff, 0x1020403, 0x201ffff, 0x1000202, 0x102ff00, 0x1030401, 0x10101ff, 0x1020304];
        let costs = [8, 7, 1, 2];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 3, total: 40 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 2, total: 11 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 8 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: 0, total: 25 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 3);
        assert(s.funded_order[1] == 2);
        assert(s.funded_order[2] == 1);
        assert(s.funded_order[3] == 0);
        assert(s.spent == 18);
    }
    // case 62: costs [1], sealed [(0, [255]), (2, [255]), (12, [1]), (0, [1]), (7, None), (11, [1])], budget 61
    {
        let mut s = empty_state::<8, 4>(1, 61);
        s.weights = [0, 2, 12, 0, 0, 11, 0, 0];
        s.ballots = [0xff, 0xff, 0x1, 0x1, 0x0, 0x1, 0x0, 0x0];
        let costs = [1, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [27, 0, 0, 0], best: 0, total: 50 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 1);
    }
    // case 63: costs [10, 3], sealed [(10, [1, 1]), (2, [0, 1]), (2, [1, 2]), (9, [255, 1]), (6, [255, 255])], budget 42
    {
        let mut s = empty_state::<8, 4>(2, 42);
        s.weights = [10, 2, 2, 9, 6, 0, 0, 0];
        s.ballots = [0x101, 0x100, 0x201, 0x1ff, 0xffff, 0x0, 0x0, 0x0];
        let costs = [10, 3, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 21 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 11 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 0);
        assert(s.spent == 13);
    }
    // case 64: costs [3], sealed [], budget 13
    {
        let mut s = empty_state::<8, 4>(1, 13);
        s.weights = [0, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [3, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [9, 0, 0, 0], best: 0, total: 9 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 3);
    }
    // case 65: costs [5], sealed [(1, None), (3, [255])], budget 14
    {
        let mut s = empty_state::<8, 4>(1, 14);
        s.weights = [0, 3, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0xff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [5, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [2, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 0);
        assert(s.spent == 0);
    }
    // case 66: costs [6, 6, 8], sealed [], budget 0
    {
        let mut s = empty_state::<8, 4>(3, 0);
        s.weights = [0, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [6, 6, 8, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 0);
        assert(s.spent == 0);
    }
    // case 67: costs [7, 2, 8], sealed [(5, [255, 1, 255]), (8, [1, 0, 0]), (6, [2, 1, 0]), (0, [3, 1, 2]), (12, [1, 1, 0])], budget 52
    {
        let mut s = empty_state::<8, 4>(3, 52);
        s.weights = [5, 8, 6, 0, 12, 0, 0, 0];
        s.ballots = [0xff01ff, 0x1, 0x102, 0x20103, 0x101, 0x0, 0x0, 0x0];
        let costs = [7, 2, 8, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [2, 7, 0, 0], best: 1, total: 30 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [2, 0, 0, 0], best: 0, total: 21 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 2, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 2, 0], best: 2, total: 19 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 0);
        assert(s.funded_order[2] == 2);
        assert(s.spent == 17);
    }
    // case 68: costs [1, 1], sealed [(10, None), (4, [0, 0]), (4, [255, 255]), (9, [1, 255])], budget 28
    {
        let mut s = empty_state::<8, 4>(2, 28);
        s.weights = [0, 4, 4, 9, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0xffff, 0xff01, 0x0, 0x0, 0x0, 0x0];
        let costs = [1, 1, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 13 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 4 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 1);
        assert(s.spent == 2);
    }
    // case 69: costs [8, 1, 10, 3], sealed [(12, [1, 0, 1, 1]), (3, [1, 4, 1, 3]), (1, None), (5, [255, 255, 255, 1]), (6, [2, 3, 1, 4]), (9, None), (2, None)], budget 59
    {
        let mut s = empty_state::<8, 4>(4, 59);
        s.weights = [12, 3, 0, 5, 6, 0, 0, 0];
        s.ballots = [0x1010001, 0x3010401, 0x0, 0x1ffffff, 0x4010302, 0x0, 0x0, 0x0];
        let costs = [8, 1, 10, 3];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [11, 6, 11, 0], best: 2, total: 32 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [8, 6, 0, 0], best: 0, total: 18 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 6, 0, 0], best: 3, total: 9 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 6, 0, 0], best: 1, total: 6 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 2);
        assert(s.funded_order[1] == 0);
        assert(s.funded_order[2] == 3);
        assert(s.funded_order[3] == 1);
        assert(s.spent == 22);
    }
}

#[test]
fn withhold_cases_7() {
    // case 70: costs [1, 9, 5], sealed [(9, [255, 255, 0]), (9, [1, 3, 2]), (4, [1, 0, 1]), (4, [1, 3, 1]), (7, [1, 255, 255]), (9, [255, 255, 0])], budget 46
    {
        let mut s = empty_state::<8, 4>(3, 46);
        s.weights = [9, 9, 4, 4, 7, 9, 0, 0];
        s.ballots = [0xffff, 0x20301, 0x10001, 0x10301, 0xffff01, 0xffff, 0x0, 0x0];
        let costs = [1, 9, 5, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 2, total: 26 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 22 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: 1, total: 15 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 2);
        assert(s.funded_order[1] == 0);
        assert(s.funded_order[2] == 1);
        assert(s.spent == 15);
    }
    // case 71: costs [3, 7, 1, 4], sealed [(12, [1, 0, 0, 0]), (3, [1, 255, 1, 255]), (3, [2, 3, 0, 1])], budget 38
    {
        let mut s = empty_state::<8, 4>(4, 38);
        s.weights = [12, 3, 3, 0, 0, 0, 0, 0];
        s.ballots = [0x1, 0xff01ff01, 0x1000302, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [3, 7, 1, 4];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 13, 11, 13], best: 3, total: 16 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 10, 8, 0], best: 0, total: 15 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 10, 8, 0], best: 2, total: 10 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 10, 0, 0], best: 1, total: 10 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 3);
        assert(s.funded_order[1] == 0);
        assert(s.funded_order[2] == 2);
        assert(s.funded_order[3] == 1);
        assert(s.spent == 15);
    }
    // case 72: costs [2, 5, 9, 6], sealed [(10, [1, 3, 0, 2]), (11, [0, 1, 0, 255]), (5, [0, 0, 0, 0]), (6, None), (1, [255, 255, 255, 255]), (12, None), (9, [0, 0, 1, 0])], budget 65
    {
        let mut s = empty_state::<8, 4>(4, 65);
        s.weights = [10, 11, 5, 0, 1, 0, 9, 0];
        s.ballots = [0x2000301, 0xff000100, 0x0, 0x0, 0xffffffff, 0x0, 0x10000, 0x0];
        let costs = [2, 5, 9, 6];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [10, 10, 10, 0], best: 1, total: 26 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [9, 0, 9, 0], best: 0, total: 23 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 9, 0], best: 2, total: 21 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: 3, total: 15 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 4);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 0);
        assert(s.funded_order[2] == 2);
        assert(s.funded_order[3] == 3);
        assert(s.spent == 22);
    }
    // case 73: costs [7], sealed [(4, [255]), (9, None), (5, [1])], budget 24
    {
        let mut s = empty_state::<8, 4>(1, 24);
        s.weights = [4, 0, 5, 0, 0, 0, 0, 0];
        s.ballots = [0xff, 0x0, 0x1, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [7, 0, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [4, 0, 0, 0], best: 0, total: 9 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 1);
        assert(s.funded_order[0] == 0);
        assert(s.spent == 7);
    }
    // case 74: costs [2, 8, 8, 7], sealed [(5, [255, 2, 1, 3]), (11, [255, 1, 255, 2]), (12, None)], budget 39
    {
        let mut s = empty_state::<8, 4>(4, 39);
        s.weights = [5, 11, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x30102ff, 0x2ff01ff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [2, 8, 8, 7];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 9, 0], best: 2, total: 14 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 11 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 2);
        assert(s.funded_order[1] == 1);
        assert(s.spent == 16);
    }
    // case 75: costs [10, 3, 2, 1], sealed [(5, [2, 2, 1, 2]), (0, [1, 1, 1, 1])], budget 24
    {
        let mut s = empty_state::<8, 4>(4, 24);
        s.weights = [5, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x2010202, 0x1010101, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [10, 3, 2, 1];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 3], best: 2, total: 5 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 3], best: 3, total: 3 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: 1, total: 3 }, ranks);
        s = tally_step(s, costs, Step { level: 2, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 3, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 4, pub_support: [0, 0, 0, 0], best: NONE, total: 0 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 2);
        assert(s.funded_order[1] == 3);
        assert(s.funded_order[2] == 1);
        assert(s.spent == 6);
    }
    // case 76: costs [9, 2], sealed [(12, [1, 1]), (12, [1, 255]), (6, [255, 255]), (7, [0, 0]), (12, [255, 1]), (10, None), (7, [255, 255])], budget 72
    {
        let mut s = empty_state::<8, 4>(2, 72);
        s.weights = [12, 12, 6, 7, 12, 0, 7, 0];
        s.ballots = [0x101, 0xff01, 0xffff, 0x0, 0x1ff, 0x0, 0xffff, 0x0];
        let costs = [9, 2, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 1, total: 31 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 0, 0, 0], best: 0, total: 30 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 0);
        assert(s.spent == 11);
    }
    // case 77: costs [6, 2, 4], sealed [(9, [0, 0, 0]), (8, [1, 255, 0]), (12, [1, 2, 255]), (3, [3, 1, 1]), (9, [255, 255, 0]), (11, None), (5, [0, 255, 255])], budget 77
    {
        let mut s = empty_state::<8, 4>(3, 77);
        s.weights = [9, 8, 12, 3, 9, 0, 5, 0];
        s.ballots = [0x0, 0xff01, 0xff0201, 0x10103, 0xffff, 0x0, 0xffff00, 0x0];
        let costs = [6, 2, 4, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 5, 5, 0], best: 0, total: 34 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 5, 5, 0], best: 2, total: 25 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [0, 5, 0, 0], best: 1, total: 14 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 3);
        assert(s.funded_order[0] == 0);
        assert(s.funded_order[1] == 2);
        assert(s.funded_order[2] == 1);
        assert(s.spent == 12);
    }
    // case 78: costs [5, 6, 6, 8], sealed [], budget 3
    {
        let mut s = empty_state::<8, 4>(4, 3);
        s.weights = [0, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [5, 6, 6, 8];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 0);
        assert(s.spent == 0);
    }
    // case 79: costs [8, 10], sealed [], budget 5
    {
        let mut s = empty_state::<8, 4>(2, 5);
        s.weights = [0, 0, 0, 0, 0, 0, 0, 0];
        s.ballots = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [8, 10, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 0);
        assert(s.spent == 0);
    }
}

#[test]
fn withhold_cases_8() {
    // case 80: costs [7, 5], sealed [(9, [0, 0]), (11, [1, 255]), (12, [1, 1]), (7, [0, 0]), (1, [255, 255]), (11, [255, 255]), (11, None), (1, [1, 1])], budget 79
    {
        let mut s = empty_state::<8, 4>(2, 79);
        s.weights = [9, 11, 12, 7, 1, 11, 0, 1];
        s.ballots = [0x0, 0xff01, 0x101, 0x0, 0xffff, 0xffff, 0x0, 0x101];
        let costs = [7, 5, 0, 0];
        let ranks = ranks_of(s);
        s = tally_step(s, costs, Step { level: 1, pub_support: [4, 16, 0, 0], best: 1, total: 45 }, ranks);
        s = tally_step(s, costs, Step { level: 1, pub_support: [4, 0, 0, 0], best: 0, total: 40 }, ranks);
        s = tally_step(s, costs, Step { level: 0, pub_support: [0; 4], best: NONE, total: 0 }, ranks);
        assert(s.done);
        assert(s.funded_count == 2);
        assert(s.funded_order[0] == 1);
        assert(s.funded_order[1] == 0);
        assert(s.spent == 12);
    }
    // case 81: costs [5, 4, 1], sealed [(9, [1, 0, 1]), (7, [255, 1, 2]), (12, [0, 0, 0])], budget 40
    {
        let mut s = empty_state::<8, 4>(3, 40);
        s.weights = [9, 7, 12, 0, 0, 0, 0, 0];
        s.ballots = [0x10001, 0x201ff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
        let costs = [5, 4, 1, 0];
        let ranks = ranks_of(s);
