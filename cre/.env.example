# Copy to cre/.env (git-ignored). Only needed to deploy or to simulate with --broadcast.
# Ethereum private key that owns the workflow in the registry (or a 1Password reference op://…).
CRE_ETH_PRIVATE_KEY=your-eth-private-key
# The tallier master secret is NOT stored here: export RANKED_SHARES_MASTER in the shell for
# simulation as CRE_RANKED_SHARES_MASTER (see README, "Off-chain: CRE workflow and secrets"), and put it in the Vault DON
# with `cre secrets create` for deployment.
